# Copy this file to .env and fill in real values.
# Never commit .env.

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=secure_file_transfer

# Generate a long random string for JWT signing
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Set to true when serving over HTTPS
COOKIE_SECURE=false

# 32-byte key as 64 hex characters. Used only to wrap file keys at rest.
# Example generation: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KEY_WRAP_SECRET=replace-with-64-hex-characters

# Practical in-browser encryption limit (bytes). UI copy still matches Stitch.
MAX_FILE_BYTES=52428800
UPLOAD_DIR=./uploads
CLEANUP_INTERVAL_MS=60000

# Optional local development fixtures. Keep false for production.
SEED_TEST_USERS=false
